{
  "dataRoles": [
    {
      "displayName": "Resource",
      "displayNameKey": "Role_Resource",
      "name": "resource",
      "kind": "Grouping",
      "description": "The machine, person or ticket: one strip each",
      "descriptionKey": "Role_Resource_Desc"
    },
    {
      "displayName": "Timestamp",
      "displayNameKey": "Role_Timestamp",
      "name": "timestamp",
      "kind": "Grouping",
      "description": "When the state changed: a date/time column (not the date hierarchy)",
      "descriptionKey": "Role_Timestamp_Desc"
    },
    {
      "displayName": "State",
      "displayNameKey": "Role_State",
      "name": "state",
      "kind": "Grouping",
      "description": "The state the resource entered at that time",
      "descriptionKey": "Role_State_Desc"
    },
    {
      "displayName": "State order",
      "displayNameKey": "Role_StateOrder",
      "name": "stateOrder",
      "kind": "Measure",
      "description": "Optional number per state: states draw in this order, lowest first (the first is the resting state)",
      "descriptionKey": "Role_StateOrder_Desc"
    },
    {
      "displayName": "As of",
      "displayNameKey": "Role_AsOf",
      "name": "asOf",
      "kind": "Measure",
      "description": "Optional date/time where every last run ends, for example a snapshot date. Without it, the latest event",
      "descriptionKey": "Role_AsOf_Desc"
    },
    {
      "displayName": "Tooltips",
      "displayNameKey": "Role_Tooltips",
      "name": "tooltips",
      "kind": "Measure",
      "description": "Extra fields shown in the tooltip of each run",
      "descriptionKey": "Role_Tooltips_Desc"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "resource": {
            "max": 1
          },
          "timestamp": {
            "max": 1
          },
          "state": {
            "max": 1
          },
          "stateOrder": {
            "max": 1
          },
          "asOf": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "bind": {
                "to": "resource"
              }
            },
            {
              "bind": {
                "to": "timestamp"
              }
            },
            {
              "bind": {
                "to": "state"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 30000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "stateOrder"
              }
            },
            {
              "bind": {
                "to": "asOf"
              }
            },
            {
              "for": {
                "in": "tooltips"
              }
            }
          ]
        }
      }
    }
  ],
